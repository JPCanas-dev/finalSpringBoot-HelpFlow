    {
      "name": "05 - Casos de Error y Validaciones RFC 7807",
      "item": [
        {
          "name": "5.1 Error 400 - Correo inválido (no corporativo @helpflow.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Formato RFC 7807 ProblemDetail devuelto\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(400);",
                  "    pm.expect(data.title).to.include('validación');",
                  "    pm.expect(data.invalidFields).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
