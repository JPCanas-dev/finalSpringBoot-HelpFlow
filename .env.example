# ============================================================
# Variables de Entorno - HelpFlow System (Plantilla de ejemplo)
# Copia este archivo como ".env" y ajusta los valores según tu entorno
# ============================================================

# --- Base de datos PostgreSQL ---
# Nombre de la base de datos
POSTGRES_DB=helpflow_db
# Usuario de la base de datos (ej: postgres, finalHelpFlow)
POSTGRES_USER=postgres
# Contraseña para la base de datos (puedes poner tu clave local, ej: 12345 o tu_password)
POSTGRES_PASSWORD=tu_password
# Puerto en tu máquina (5436 para no chocar con un Postgres local en el 5432)
POSTGRES_PORT=5436

# --- Conexión DataSource (support-ticket-service) ---
# Si ejecutas con Docker deja "db:5432". Si lo corres directo en IntelliJ/local usa "localhost:5436"
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/helpflow_db
# Debe ser el mismo usuario que POSTGRES_USER
SPRING_DATASOURCE_USERNAME=postgres
# Debe ser la misma contraseña que POSTGRES_PASSWORD
SPRING_DATASOURCE_PASSWORD=tu_password

# --- Seguridad JWT ---
# Clave secreta para firmar tokens (puedes dejar esta para desarrollo o poner una personalizada)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Duración del token en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# --- Comunicación entre microservicios ---
# URL del servicio de técnicos (en Docker usa el nombre del contenedor, en local usa localhost)
TECHNICIAN_DISPATCH_SERVICE_URL=http://technician-dispatch-service:8081

# --- Puertos de los servicios en tu máquina ---
# Puerto para la API de tickets
SUPPORT_TICKET_PORT=8080
# Puerto para el microservicio de despacho
TECHNICIAN_DISPATCH_PORT=8081
